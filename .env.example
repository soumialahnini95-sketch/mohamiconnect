# MySQL de développement uniquement (ne pas pointer vers une base de production)
DATABASE_URL=

# Authentification OAuth de l’application (configurer une URL de retour locale autorisée)
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=
OWNER_OPEN_ID=

# Services Manus optionnels, si le projet les utilise
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=

# Facultatif; le serveur utilise 3000 par défaut
PORT=3000
